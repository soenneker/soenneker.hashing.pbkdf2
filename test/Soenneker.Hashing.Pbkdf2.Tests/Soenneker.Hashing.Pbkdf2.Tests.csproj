        <PackageReference Include="TUnit" Version="1.76.45" />
        <PackageReference Include="Soenneker.Tests.Benchmark" Version="11.0.219" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Hashing.Pbkdf2\Soenneker.Hashing.Pbkdf2.csproj" />
    </ItemGroup>
  <ItemGroup>
    <Compile Remove="**/Benchmarks/**/*.cs" />
    <Compile Remove="**/Benchmarking/**/*.cs" />
  </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    </ItemGroup>
</Project>



